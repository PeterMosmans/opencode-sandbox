# Don't add anything here to the image...
*
.*
# ...except the required package files...
!requirements.txt
!package.json
!docker-entrypoint.sh
!dockerd-sandboxed.sh
# .. and optional certificate files
!*.pem
# ... and optional local Python modules (installed by the Dockerfile)
!extra
!extra/**
# Local build artifacts inside the extra modules are never installed
extra/**/__pycache__
extra/**/.pytest_cache
extra/**/.ruff_cache
extra/**/.venv
extra/**/*.egg-info
extra/**/dist
